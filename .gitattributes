# Auto-detect text files, normalise line endings to LF on commit
* text=auto

# Source code — force LF
*.java     text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.py       text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.xml      text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf
*.env.example text eol=lf

# Shell scripts must be LF (won't run on Linux otherwise)
*.sh       text eol=lf

# Windows-specific — keep CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binary files — never touch line endings
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.jar      binary
*.class    binary
*.lock     binary
