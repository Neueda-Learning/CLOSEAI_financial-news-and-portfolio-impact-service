# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#   cp .env.example .env
#
# ZERO-CONFIG STARTUP: copy this file as-is, run `docker compose up -d`,
# and the app boots with mock providers (no real API keys needed).
#
# For live data, fill in the Finnhub + LLM sections and switch the provider
# flags at the bottom from mock/stub to finnhub/agent.

# --- Database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
MYSQL_DATABASE=fnpis
MYSQL_USER=fnpis_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# --- Finnhub: two separate accounts ---------------------------------------
# Required only when PROVIDER_NEWS=finnhub or PROVIDER_PRICE=finnhub.
# News and prices use different keys on purpose — one hitting its quota
# cannot starve the other. Rate limiters are configured per key.
FINNHUB_KEY_NEWS=
FINNHUB_KEY_PRICE=

# --- Twelve Data: backup price provider -----------------------------------
# Free tier: 800 req/day. Leave empty to skip and fall through to mock/DB.
TWELVEDATA_API_KEY=

# --- LLM sentiment engine -------------------------------------------------
# Required only when PROVIDER_SENTIMENT=agent.
# Guard this one hardest: a leaked LLM key bills real money.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- App ------------------------------------------------------------------
SERVER_PORT=8080

# Provider switches — all three default to offline for zero-config startup.
#   news:      finnhub | mock (mock: returns empty, no keys needed)
#   price:     finnhub | mock (mock: returns empty quotes)
#   sentiment: agent   | stub (stub: fixed POSITIVE/NEGATIVE/NEUTRAL)
PROVIDER_NEWS=mock
PROVIDER_PRICE=mock
PROVIDER_SENTIMENT=stub

# --- Admin endpoints ------------------------------------------------------
ADMIN_ENABLED=false
ADMIN_TOKEN=
ADMIN_IDENTITY=admin-token:demo
