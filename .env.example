# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#   cp .env.example .env
#
# Leaking a key to GitHub is a real accident, not a hypothetical one. Nothing
# in this file has a default in application.yml either - the app fails fast at
# startup naming the missing variable, which beats collecting 401s minutes
# later (architecture 7.5).

# --- Database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
MYSQL_DATABASE=fnpis
MYSQL_USER=fnpis_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# --- Finnhub: two separate accounts ---------------------------------------
# News and prices use different keys on purpose so one chain exhausting its
# quota cannot starve the other. Rate limiters are configured per key
# (architecture 6.5).
#
# Two things to verify before relying on this: whether Finnhub rate limits per
# key or per IP - if per IP, separate accounts on one machine buy nothing - and
# whether the free tier permits one person holding several accounts.
FINNHUB_KEY_NEWS=your_finnhub_news_key_here
FINNHUB_KEY_PRICE=your_finnhub_price_key_here

# --- Twelve Data: backup price provider -----------------------------------
# Free tier: 800 req/day. Used when Finnhub price chain is down or rate-limited.
# Leave unset to skip Twelve Data and fall straight through to mock/cache.
TWELVEDATA_API_KEY=your_twelvedata_key_here

# --- LLM sentiment engine -------------------------------------------------
# Guard this one hardest: unlike a quota-capped market data key, a leaked LLM
# key bills real money.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=
LLM_MODEL=

# --- App ------------------------------------------------------------------
SERVER_PORT=8080

# Provider switches.
#   news: finnhub (mock reserved, not wired yet)
#   price: finnhub | mock (mock wired via @ConditionalOnProperty)
#   sentiment: agent | stub (wired by D/E)
PROVIDER_NEWS=finnhub
PROVIDER_PRICE=finnhub
PROVIDER_SENTIMENT=agent
